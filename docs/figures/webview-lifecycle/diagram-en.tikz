#| mainfont: Noto Sans CJK JP
% English version: activation, preview creation, hide/show, and how memory and startup cost stay low.
% Semantic node IDs match child directories; notes and helpers have no ID.
\definecolor{navy}{HTML}{0E3666}
\definecolor{aliceblue}{HTML}{E8F1FE}
\definecolor{azureblue}{HTML}{428CE6}
\definecolor{paleskyblue}{HTML}{B4D7FF}
\definecolor{fontblack}{HTML}{1A1A1A}
\definecolor{darkgray}{HTML}{575757}
\definecolor{lightgray}{HTML}{DEDEDE}
\definecolor{crimsonred}{HTML}{D31804}
\definecolor{mistyrose}{HTML}{FBE7E6}
\begin{tikzpicture}[
  every node/.style={text=fontblack},
  block/.style={draw=navy,fill=aliceblue,rounded corners=3pt,
    align=center,minimum width=3.6cm,minimum height=1.25cm,inner sep=8pt},
  entry/.style={block,line width=1.6pt},
  accent/.style={block,fill=paleskyblue},
  store/.style={block,shape=cylinder,shape border rotate=90,aspect=0.15,
    rounded corners=0pt,fill=white,minimum height=1.0cm},
  external/.style={block,draw=darkgray,fill=white,dashed},
  rel/.style={font=\footnotesize,text=darkgray,fill=white,inner sep=2pt},
  note/.style={font=\footnotesize,text=darkgray,align=center},
  step/.style={font=\footnotesize\bfseries,text=azureblue},
  >={Stealth[length=2.5mm]},font=\small,line width=0.7pt
]
  \node[entry] (activation) at (0,0) {Lazy activation\\\texttt{activate()}};
  \node[block] (custom-editor-provider) at (7.4,1.5) {Preview-only editor\\\texttt{SvgPreviewEditorProvider}};
  \node[block] (side-panel) at (7.4,-1.5) {Side preview\\\texttt{openPreview}};
  \node[accent] (attach-preview) at (13.8,0) {\texttt{attachPreview}\\register, sync on \texttt{ready}};
  \node[block] (webview-script) at (20.4,0) {Webview script\\\texttt{media/preview.js}};
  \node[external] (vscode-webview-host) at (20.4,-3.8) {VS Code\\webview host};

  \draw[->,navy] (activation.east) -- ++(0.6,0) |- node[rel,pos=0.75,above] {registers provider} (custom-editor-provider.west);
  \draw[->,navy] (activation.east) -- ++(0.6,0) |- node[rel,pos=0.75,below] {commands / \texttt{autoOpen}} (side-panel.west);
  \draw[->,navy] (custom-editor-provider.east) -- ++(0.7,0) |- node[rel,pos=0.25,right] {on resolve} ([yshift=3mm]attach-preview.west);
  \draw[->,navy] (side-panel.east) -- ++(0.7,0) |- node[rel,pos=0.25,right] {on create} ([yshift=-3mm]attach-preview.west);
  \draw[->,navy] ([yshift=3mm]attach-preview.east) -- node[rel,above] {\texttt{config} → \texttt{update}} ([yshift=3mm]webview-script.west);
  \draw[->,navy] ([yshift=-3mm]webview-script.west) -- node[rel,below] {\texttt{ready}} ([yshift=-3mm]attach-preview.east);
  \draw[->,navy] ([xshift=-6mm]vscode-webview-host.north) -- node[rel,left] {reload when shown} ([xshift=-6mm]webview-script.south);
  \draw[->,navy] ([xshift=6mm]webview-script.south) -- node[rel,right] {\texttt{setState} (zoom, fit)} ([xshift=6mm]vscode-webview-host.north);

  \node[step,above=4mm of activation] {① Start only when needed};
  \node[step,above=4mm of webview-script] {③ Exists only while visible};
  \node[step,anchor=south] at ($(attach-preview.north)+(0,0.4)$) {② One initial send, on ready};
  \node[note,below=3mm of activation] {\texttt{onCustomEditor}, \texttt{onLanguage:xml}\\no workspace scan at startup};
  \node[note,anchor=north east] at ([xshift=-3mm]vscode-webview-host.north west) {no \texttt{retainContextWhenHidden}\\→ hidden tabs keep no rendered SVG};
\end{tikzpicture}
