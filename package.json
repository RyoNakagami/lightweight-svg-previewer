{
  "name": "lightweight-svg-previewer",
  "displayName": "Lightweight SVG Previewer",
  "description": "Open SVG files as a preview-only editor; press Ctrl+Enter to edit the source beside it with live updates. Zero runtime dependencies.",
  "version": "0.1.0",
  "publisher": "RyoNak",
  "license": "MIT",
  "icon": "images/icon.png",
  "homepage": "https://github.com/RyoNakagami/lightweight-svg-previewer#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/RyoNakagami/lightweight-svg-previewer.git"
  },
  "bugs": {
    "url": "https://github.com/RyoNakagami/lightweight-svg-previewer/issues"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "svg",
    "preview",
    "viewer",
    "lightweight",
    "live"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:xml",
    "onCustomEditor:lightweightSvgPreviewer.editor"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "lightweightSvgPreviewer.editor",
        "displayName": "SVG Preview",
        "selector": [
          {
            "filenamePattern": "*.svg"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "lightweightSvgPreviewer.showPreview",
        "title": "Open SVG Preview to the Side",
        "category": "SVG Preview"
      },
      {
        "command": "lightweightSvgPreviewer.togglePreview",
        "title": "Toggle Preview",
        "category": "SVG Preview"
      },
      {
        "command": "lightweightSvgPreviewer.showSource",
        "title": "Show Source to the Side",
        "category": "SVG Preview",
        "icon": "$(go-to-file)"
      }
    ],
    "keybindings": [
      {
        "command": "lightweightSvgPreviewer.togglePreview",
        "key": "ctrl+k v",
        "when": "editorTextFocus && resourceExtname == .svg"
      },
      {
        "command": "lightweightSvgPreviewer.showSource",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "activeCustomEditorId == 'lightweightSvgPreviewer.editor'"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "lightweightSvgPreviewer.showPreview",
          "when": "resourceExtname == .svg && activeCustomEditorId != 'lightweightSvgPreviewer.editor'",
          "group": "navigation"
        },
        {
          "command": "lightweightSvgPreviewer.showSource",
          "when": "activeCustomEditorId == 'lightweightSvgPreviewer.editor'",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "lightweightSvgPreviewer.showPreview",
          "when": "resourceExtname == .svg",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "lightweightSvgPreviewer.showSource",
          "when": "activeCustomEditorId == 'lightweightSvgPreviewer.editor'"
        }
      ]
    },
    "configuration": {
      "title": "Lightweight SVG Previewer",
      "properties": {
        "lightweightSvgPreviewer.debounceMs": {
          "type": "number",
          "default": 150,
          "minimum": 0,
          "maximum": 2000,
          "description": "Milliseconds to wait after the last edit before refreshing the preview."
        },
        "lightweightSvgPreviewer.autoOpen": {
          "type": "boolean",
          "default": false,
          "description": "When an SVG is opened in a text editor, automatically open a side preview (skipped if the SVG Preview editor already shows it)."
        },
        "lightweightSvgPreviewer.background": {
          "type": "string",
          "enum": [
            "checkerboard",
            "editor",
            "transparent",
            "white",
            "black"
          ],
          "default": "checkerboard",
          "description": "Background style for the preview canvas."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -p . -w",
    "typecheck": "tsc -p . --noEmit",
    "test": "npm run compile && node --test \"dist/**/*.test.js\"",
    "test:unit": "npm test",
    "package": "vsce package",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^2.24.0",
    "typescript": "^5.4.0"
  }
}
